<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

    <Type Name="Kitsune::Array&lt;*&gt;">
        <Intrinsic Name="Size" Expression="(Usize)(m_End - m_Begin)" />
        <Intrinsic Name="Capacity" Expression="(Usize)(m_StorageEnd - m_Begin)" />
        <DisplayString>{{ Count={Size()} }}</DisplayString>

        <Expand>
            <ArrayItems Condition="m_Begin != nullptr">
                <Size>Size()</Size>
                <ValuePointer>m_Begin</ValuePointer>
            </ArrayItems>
            <Item Name="[Size]">Size()</Item>
            <Item Name="[Capacity]">Capacity()</Item>
        </Expand>
    </Type>
    
    <Type Name="Kitsune::VectorBase&lt;*,2&gt;">
        <DisplayString>{{{x}, {y}}}</DisplayString>
        <Expand>
            <Item Name="[X-Axis]">x</Item>
            <Item Name="[Y-Axis]">y</Item>
        </Expand>
    </Type>
    
    <Type Name="Kitsune::ScopedPtr&lt;*&gt;">
        <SmartPointer Usage="Minimal">m_Pointer</SmartPointer>
        <DisplayString Condition="m_Pointer == nullptr">[Empty]</DisplayString>
        <DisplayString Condition="m_Pointer != nullptr">{*m_Pointer}</DisplayString>

        <Expand>
            <Item Condition="m_Pointer != nullptr" Name="[Pointer]">m_Pointer</Item>
            <Item Condition="m_Pointer != nullptr" Name="[Deleter]">m_Deleter</Item>
        </Expand>
    </Type>
    
    <Type Name="Kitsune::SharedPtr&lt;*&gt;">
        <SmartPointer Usage="Minimal">m_Pointer</SmartPointer>
        <DisplayString Condition="m_Pointer == nullptr">[Empty]</DisplayString>
        <DisplayString Condition="m_Pointer != nullptr">{*m_Pointer}</DisplayString>

        <Expand>
            <Item Condition="m_Pointer != nullptr" Name="[Pointer]">m_Pointer</Item>
            
            <Item Condition="m_Data != nullptr" Name="[Shared Count]">m_Data->m_SharedCount</Item>
            <Item Condition="m_Data != nullptr" Name="[Weak Count]">m_Data->m_WeakCount</Item>
        </Expand>
    </Type>
    
    <Type Name="Kitsune::WeakPtr&lt;*&gt;">
        <SmartPointer Usage="Minimal">m_Pointer</SmartPointer>
        <DisplayString Condition="m_Pointer == nullptr">[Empty]</DisplayString>
        <DisplayString Condition="m_Pointer != nullptr">{*m_Pointer}</DisplayString>

        <Expand>
            <Item Condition="m_Pointer != nullptr" Name="[Pointer]">m_Pointer</Item>
            
            <Item Condition="m_Data != nullptr" Name="[Shared Count]">m_Data->m_SharedCount</Item>
            <Item Condition="m_Data != nullptr" Name="[Weak Count]">m_Data->m_WeakCount</Item>
        </Expand>
    </Type>

    <Type Name="Kitsune::BasicString&lt;*&gt;">
        <DisplayString>{m_Data.Pointer}</DisplayString>
        <Expand>
            <Item Name="[String]">m_Data.Pointer</Item>
            <Item Name="[Size]">m_Data.Size</Item>
        </Expand>
    </Type>

    <Type Name="Kitsune::BasicStringView&lt;*&gt;">
        <DisplayString>{m_Data.Pointer}</DisplayString>
        <Expand>
            <Item Name="[String]">m_Pointer</Item>
            <Item Name="[Size]">m_Size</Item>
        </Expand>
    </Type>

    <Type Name="Kitsune::Function&lt;*&gt;">
        <DisplayString Condition="m_Pointer != nullptr">{m_Pointer}</DisplayString>
        <DisplayString Condition="m_Pointer == nullptr">[Empty]</DisplayString>
    </Type>

</AutoVisualizer>
