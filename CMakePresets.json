{
  "version": 2,
  "configurePresets": [
    {
      "name": "Base Preset",
      "hidden": true,

      "binaryDir": "${sourceDir}/build",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      }
    },
    {
      "name": "Visual Studio 2022",
      "generator": "Visual Studio 17 2022",

      "cacheVariables": {
        "CMAKE_SHARED_LINKER_FLAGS_OPTIMIZED": "",
        "CMAKE_EXE_LINKER_FLAGS_OPTIMIZED": "",
        "CMAKE_SHARED_LINKER_FLAGS_PRODUCTION": "",
        "CMAKE_EXE_LINKER_FLAGS_PRODUCTION": ""
      },

      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "Visual Studio"
        }
      },

      "inherits": [ "Base Preset" ]
    },
    {
      "name": "MinGW Clang",
      "generator": "Ninja",

      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang.exe",
        "CMAKE_CXX_COMPILER": "clang++.exe"
      },

      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "MinGW Clang"
        }
      },

      "inherits": [ "Base Preset" ]
    }
  ],

  "buildPresets": [
    {
      "name": "Visual Studio 2022 -- Debug",
      "configurePreset": "Visual Studio 2022",
      "configuration": "Debug"
    },
    {
      "name": "Visual Studio 2022 -- Optimized",
      "configurePreset": "Visual Studio 2022",
      "configuration": "Optimized"
    },
    {
      "name": "Visual Studio 2022 -- Production",
      "configurePreset": "Visual Studio 2022",
      "configuration": "Production"
    },

    {
      "name": "MinGW Clang -- Debug",
      "configurePreset": "MinGW Clang",
      "configuration": "Debug"
    },
    {
      "name": "MinGW Clang -- Optimized",
      "configurePreset": "MinGW Clang",
      "configuration": "Optimized"
    },
    {
      "name": "MinGW Clang -- Production",
      "configurePreset": "MinGW Clang",
      "configuration": "Production"
    }
  ]
}
